# Copy these into Vercel: Project > Settings > Environment Variables. NEVER commit real values.

# --- Required ---
GEMINI_API_KEY=
IP_HASH_SALT=any-long-random-string

# --- Backup AI (free key from console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_DAILY_LIMIT=400

# --- Third AI: OpenRouter free models (key from openrouter.ai/keys). Pick IDs ending in :free from /api/health ---
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
OPENROUTER_DAILY_LIMIT=40
# Default refuses providers that log prompts. Set to true only if free models then fail with a 'data policy' error.
OPENROUTER_ALLOW_DATA_COLLECTION=false

# --- Handoff alerts (set Telegram, and optionally email as a backup) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL=rommeldelatorre8@gmail.com

# --- Rate limiting storage (Upstash Redis via Vercel Marketplace sets these for you) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
ALLOWED_ORIGINS=https://romsyncai.vercel.app,http://localhost:3000
CALENDLY_URL=https://calendly.com/rommeldelatorre8/30min
GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GLOBAL_DAILY_LIMIT=300
LIMIT_IP_PER_MIN=6
LIMIT_IP_PER_HOUR=30
LIMIT_IP_PER_DAY=80
LIMIT_SESSION_TOTAL=30

# Optional: temporary token to open /api/health?token=... for diagnosing. Delete it afterwards.
HEALTH_TOKEN=
