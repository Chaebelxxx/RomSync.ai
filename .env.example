# Copy these into Vercel: Project > Settings > Environment Variables. NEVER commit real values.

# --- Required ---
GEMINI_API_KEY=
IP_HASH_SALT=any-long-random-string

# --- Handoff alerts (set Telegram, and optionally email as a backup) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL=rommeldelatorre8@gmail.com

# --- Rate limiting storage (Upstash Redis via Vercel Marketplace sets these for you) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
ALLOWED_ORIGINS=https://romsyncai.vercel.app,http://localhost:3000
CALENDLY_URL=https://calendly.com/rommeldelatorre8/30min
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GLOBAL_DAILY_LIMIT=300
LIMIT_IP_PER_MIN=6
LIMIT_IP_PER_HOUR=30
LIMIT_IP_PER_DAY=80
LIMIT_SESSION_TOTAL=30

# Optional: temporary token to open /api/health?token=... for diagnosing. Delete it afterwards.
HEALTH_TOKEN=
